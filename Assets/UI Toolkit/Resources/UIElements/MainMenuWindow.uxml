<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:fund="Org.Ethasia.Fundetected.Technical.UIToolkit" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/MainMenuWindowStyle.uss?fileID=7433441132597879392&amp;guid=3e90721e7fc375f47809f5ca50f36979&amp;type=3#MainMenuWindowStyle" />
    
    <fund:FunDetectedWindow name="base-window" title-key="main-menu-window-title" hide-close-button="true" class="main-menu-window">
        <engine:VisualElement name="main-menu-buttons" class="main-menu-buttons">
            <engine:Button name="main-menu-save-button" text="Save" class="WindowsButton main-menu-button" />
            <engine:Button name="main-menu-quit-button" text="Quit" class="WindowsButton main-menu-button" />
        </engine:VisualElement>
    </fund:FunDetectedWindow>
</engine:UXML>
